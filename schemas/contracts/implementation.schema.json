{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SFsmiths implementation contract (04-implementation.json)",
  "description": "What changed, deviations, analyzer disposition, deploy reports \u2014 plan-lint checks components against the plan.",
  "type": "object",
  "required": [
    "components",
    "files",
    "tests",
    "deviations",
    "analyzer",
    "deploy"
  ],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "api_name",
          "action"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "api_name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,200}$"
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "modify",
              "delete"
            ]
          },
          "plan_ref": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object",
          "api_name",
          "action"
        ],
        "properties": {
          "object": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,200}$"
          },
          "api_name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,200}$"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "change"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "change": {
            "type": "string"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "why"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 0
          }
        }
      }
    },
    "analyzer": {
      "type": "object",
      "required": [
        "run"
      ],
      "properties": {
        "run": {
          "type": "boolean"
        },
        "findings": {
          "type": "integer"
        },
        "fixed": {
          "type": "integer"
        },
        "waived": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule",
              "why"
            ],
            "properties": {
              "rule": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            }
          }
        },
        "report": {
          "type": "string"
        }
      }
    },
    "deploy": {
      "type": "object",
      "required": [
        "dev_report"
      ],
      "properties": {
        "dev_report": {
          "type": "string"
        },
        "uat_validate_report": {
          "type": [
            "string",
            "null"
          ]
        },
        "dev_status": {
          "type": "string"
        },
        "uat_status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "how_to_verify": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    }
  },
  "additionalProperties": true,
  "$defs": {
    "evidence": {
      "$id": "evidence-ref",
      "type": "object",
      "required": [
        "source",
        "ref"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "vault",
            "tracker",
            "git",
            "human"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "verified_at": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
