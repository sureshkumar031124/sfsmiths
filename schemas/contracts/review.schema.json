{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SFsmiths review contract (06-review.json)",
  "description": "Verdict, security posture (crud_fls + sharing required by the security gate), findings with evidence, plan conformance.",
  "type": "object",
  "required": [
    "verdict",
    "security",
    "findings",
    "acceptance_criteria",
    "plan_conformance",
    "deploy_brief_file"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVE",
        "APPROVE_WITH_NITS",
        "REQUEST_CHANGES"
      ]
    },
    "same_alias_warning": {
      "type": "boolean"
    },
    "security": {
      "type": "object",
      "required": [
        "crud_fls",
        "sharing",
        "injection"
      ],
      "properties": {
        "crud_fls": {
          "type": "string",
          "minLength": 3
        },
        "sharing": {
          "type": "string",
          "minLength": 3
        },
        "injection": {
          "type": "string",
          "minLength": 2
        },
        "hardcoded": {
          "type": "string"
        },
        "pii_logging": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "verdict"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "ok",
              "warn",
              "fail",
              "na"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 0
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "dimension",
          "text",
          "evidence"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor",
              "nit"
            ]
          },
          "dimension": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 1
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "test": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "proven",
              "unproven",
              "failed"
            ]
          }
        }
      }
    },
    "plan_conformance": {
      "type": "object",
      "required": [
        "unplanned",
        "missing"
      ],
      "properties": {
        "unplanned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deviations_ok": {
          "type": "boolean"
        }
      }
    },
    "deploy_brief_file": {
      "type": "string"
    },
    "deploy_manifest_file": {
      "type": "string",
      "description": "D-100: 06c-deploy-manifest.md written by `sfsmiths agent deploy-manifest` — the reviewer references it, never retypes the component list"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    }
  },
  "additionalProperties": true,
  "$defs": {
    "evidence": {
      "$id": "evidence-ref",
      "type": "object",
      "required": [
        "source",
        "ref"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "vault",
            "tracker",
            "git",
            "human"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "verified_at": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
