{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SFsmiths test report contract (05-test-report.json / 07-uat-report.json)",
  "description": "Every test with its outcome and run file; verdict must match the run files (assertion-referee, test-quality).",
  "type": "object",
  "required": [
    "tests",
    "defects",
    "verdict",
    "evidence"
  ],
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "dev",
        "uat"
      ]
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "layer",
          "outcome",
          "run_file"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "layer": {
            "type": "string",
            "enum": [
              "apex",
              "inverse",
              "flow",
              "distribution",
              "permission",
              "ui",
              "regression",
              "other"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "Pass",
              "Fail",
              "CompileFail",
              "Skip",
              "holds",
              "violated",
              "observed"
            ]
          },
          "run_file": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "severity",
          "evidence"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "component": {
            "type": "string"
          },
          "for_agent": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 1
          }
        }
      }
    },
    "coverage": {
      "type": [
        "number",
        "null"
      ]
    },
    "flaky": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heal_review": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not-applicable",
        "reviewed",
        "pending",
        null
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    }
  },
  "additionalProperties": true,
  "$defs": {
    "evidence": {
      "$id": "evidence-ref",
      "type": "object",
      "required": [
        "source",
        "ref"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "vault",
            "tracker",
            "git",
            "human"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "verified_at": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
