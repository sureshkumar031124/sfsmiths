{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SFsmiths comms contract (10-comms/index.json)",
  "description": "Drafts with audience and the vault sources every statement traces to.",
  "type": "object",
  "required": [
    "drafts",
    "sources"
  ],
  "properties": {
    "drafts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "audience",
          "purpose"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "audience": {
            "type": "string",
            "enum": [
              "client-visible",
              "internal"
            ]
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "holding_note": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    }
  },
  "additionalProperties": true,
  "$defs": {
    "evidence": {
      "$id": "evidence-ref",
      "type": "object",
      "required": [
        "source",
        "ref"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "vault",
            "tracker",
            "git",
            "human"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "verified_at": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
