{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "slack"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "slack": {
      "type": "object",
      "required": [
        "enabled",
        "webhook_env",
        "on"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "webhook_env": {
          "type": "string"
        },
        "on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "title": "config/notify.yaml"
}
