{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "agents"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "fallback": {
      "type": "string"
    },
    "effort": {
      "type": "object",
      "description": "D-095: agent name -> reasoning effort. 'inherit' writes no effort line (session level applies).",
      "additionalProperties": {
        "enum": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "inherit"
        ]
      }
    },
    "fallback_effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "inherit"
      ],
      "description": "D-095: effort for any agent not listed in `effort`."
    }
  },
  "title": "config/models.yaml"
}
