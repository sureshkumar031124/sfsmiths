{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "agents"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "fallback": {
      "type": "string"
    }
  },
  "title": "config/models.yaml"
}
