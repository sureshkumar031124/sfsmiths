{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "approvers"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "slack": {
            "type": "string"
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "title": "config/approvers.yaml"
}
