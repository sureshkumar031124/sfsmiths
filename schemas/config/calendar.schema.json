{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "timezone",
    "freeze_windows"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "timezone": {
      "type": "string"
    },
    "freeze_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "from",
          "to"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "title": "config/calendar.yaml"
}
