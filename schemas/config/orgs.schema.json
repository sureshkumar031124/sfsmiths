{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "default_count",
    "orgs"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "default_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "orgs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "alias",
          "role",
          "keychain",
          "write"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,40}$"
          },
          "role": {
            "enum": [
              "development",
              "preprod",
              "evidence"
            ]
          },
          "keychain": {
            "enum": [
              "agent",
              "engine"
            ]
          },
          "write": {
            "type": "boolean"
          },
          "readonly_user": {
            "type": [
              "string",
              "null"
            ]
          },
          "email_deliverability": {
            "enum": [
              "system_only",
              "no_access",
              "all_email",
              "unknown"
            ]
          },
          "deliverability_verified_on": {
            "type": [
              "string",
              "null"
            ]
          },
          "deliverability_verified_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "instance_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "title": "config/orgs.yaml"
}
